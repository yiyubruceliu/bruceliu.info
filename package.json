{
  "name": "bruceliu.info",
  "version": "1.0.0",
  "description": "bruce liu personal website",
  "targets": {
    "main": false
  },
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "type": "module",
  "scripts": {
    "dev": "parcel index.html experience.html projects.html recommendations.html",
    "cname": "Copy CNAME dist\\CNAME",
    "robots": "Copy robots.txt dist\\robots.txt",
    "llms": "Copy llms.txt dist\\llms.txt",
    "sitemap": "Copy sitemap.xml dist\\sitemap.xml",
    "copy-static": "npm run cname && npm run robots && npm run llms && npm run sitemap",
    "check-dist": "if not exist dist mkdir dist",
    "clean": "npm run check-dist && rmdir /Q /S dist && mkdir dist",
    "prod": "npm run clean && parcel build index.html experience.html projects.html recommendations.html && npm run copy-static && rmdir /Q /S .parcel-cache",
    "save-changes": "git add . && git commit -m \"changes\" && git push",
    "git-del": "git branch -D gh-pages",
    "git-split": "git subtree split --prefix dist -b gh-pages",
    "git-publish": "git push -f https://github.com/yiyubruceliu/bruceliu.info.git gh-pages:gh-pages",
    "deploy": "npm run prod && npm run save-changes && npm run git-split && npm run git-publish && npm run git-del"
  },
  "keywords": [
    "Digital Strategist",
    "UX / UI Developer"
  ],
  "author": "Bruce Liu",
  "license": "UNLICENSED",
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-jsonld": "^2.16.4",
    "gh-pages": "^6.3.0",
    "i": "^0.3.7"
  },
  "dependencies": {
    "animate.css": "^3.7.2",
    "animate.min.css": "0.0.3",
    "axios": "^1.18.1",
    "bootstrap": "^4.5.0",
    "desandro-matches-selector": "^2.0.2",
    "ev-emitter": "^1.1.1",
    "fizzy-ui-utils": "^2.0.7",
    "get-size": "^2.0.3",
    "http": "^0.0.1-security",
    "isotope": "^1.0.0-alpha.3",
    "jquery": "^3.5.1",
    "jquery-migrate": "^3.3.1",
    "js": "^0.1.0",
    "lightcase": "^2.5.0",
    "masonry-layout": "^4.2.2",
    "natural": "^5.2.4",
    "node-fetch": "^3.2.10",
    "outlayer": "^2.1.1",
    "parcel": "^2.0.1",
    "popper": "^1.0.1",
    "popper.js": "^1.16.1",
    "wow": "^0.0.3",
    "wowjs": "^1.1.3"
  }
}
